# Headers for all files
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-XSS-Protection: 1; mode=block

# Cache static assets with long expiry and immutable flag
/static/*
  Cache-Control: public, max-age=31536000, immutable
  Link: </images/Background2.webp>; rel=preload; as=image; type=image/webp
  Link: </images/HomePage1.webp>; rel=preload; as=image; type=image/webp

# Cache images with long expiry
/images/*
  Cache-Control: public, max-age=31536000, immutable
  Vary: Accept

# Cache WebP images with long expiry
*.webp
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/webp
  Vary: Accept

# Cache JavaScript and CSS with long expiry
*.js
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/javascript

*.css
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: text/css

# HTML files - shorter cache with stale-while-revalidate
*.html
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  Content-Type: text/html; charset=utf-8
  Link: <https://fonts.googleapis.com>; rel=preconnect; crossorigin
  Link: <https://fonts.gstatic.com>; rel=preconnect; crossorigin

# Service Worker - no cache
/service-worker.js
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: application/javascript

# Manifest
/manifest.json
  Cache-Control: public, max-age=86400
  Content-Type: application/manifest+json
